{
  "name": "tempo-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run generate:api && tsc -b && vite build",
    "generate:api": "../.venv/bin/python ../scripts/export_openapi.py && openapi-typescript ../openapi.json -o src/api-schema.ts",
    "tempo": "npm run build && ../.venv/bin/alembic -c ../alembic.ini upgrade head && ../.venv/bin/uvicorn tempo.main:app --host 127.0.0.1 --port 8000",
    "test": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "6.4.3",
    "typescript": "5.7.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "openapi-typescript": "7.6.1"
  }
}
